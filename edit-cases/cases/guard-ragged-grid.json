{
  "id": "guard-ragged-grid",
  "description": "Fails a column guard on a ragged table without a consistent grid with E3201.",
  "input": {
    "bodyXml": [
      "    <w:tbl>",
      "      <w:tr>",
      "        <w:tc><w:p><w:r><w:t>North</w:t></w:r></w:p></w:tc>",
      "        <w:tc><w:p><w:r><w:t>Revenue</w:t></w:r></w:p></w:tc>",
      "      </w:tr>",
      "      <w:tr>",
      "        <w:tc><w:p><w:r><w:t>South</w:t></w:r></w:p></w:tc>",
      "        <w:tc><w:p><w:r><w:t>Profit</w:t></w:r></w:p></w:tc>",
      "        <w:tc><w:p><w:r><w:t>Extra</w:t></w:r></w:p></w:tc>",
      "      </w:tr>",
      "    </w:tbl>"
    ]
  },
  "patch": [
    "docxpatch 1",
    "",
    "op set-cell",
    "target M.T0001.R01.C01",
    "expect-column-count 2",
    "text South",
    "end"
  ],
  "expect": {
    "applySuccess": false,
    "diagnosticCount": 1,
    "diagnosticCodes": [
      "E3201"
    ],
    "diagnosticMessagesContain": [
      "consistent visual grid"
    ]
  }
}
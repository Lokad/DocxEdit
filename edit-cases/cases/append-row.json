{
  "id": "append-row",
  "description": "Appends a guarded table row and verifies cell readback.",
  "input": {
    "bodyXml": [
      "    <w:tbl>",
      "      <w:tr><w:tc><w:p><w:r><w:t>North</w:t></w:r></w:p></w:tc></w:tr>",
      "    </w:tbl>"
    ]
  },
  "patch": [
    "docxpatch 1",
    "",
    "op append-row",
    "target M.T0001",
    "expect-row-count 1",
    "expect-column-count 1",
    "cell South",
    "end"
  ],
  "expect": {
    "diagnosticCount": 0,
    "tableCells": [
      "North",
      "South"
    ]
  }
}
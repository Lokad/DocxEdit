{
  "id": "styled-insert",
  "description": "Inserts ordered paragraphs with per-paragraph styles resolved by ID.",
  "input": {
    "stylesXml": [
      "  <w:style w:type=\"paragraph\" w:styleId=\"Normal\"><w:name w:val=\"Normal\"/></w:style>",
      "  <w:style w:type=\"paragraph\" w:styleId=\"Heading1\"><w:name w:val=\"heading 1\"/></w:style>"
    ],
    "bodyXml": [
      "    <w:p><w:r><w:t>Alpha</w:t></w:r></w:p>"
    ]
  },
  "patch": [
    "docxpatch 1",
    "",
    "op insert-after",
    "target M.P0001",
    "text First",
    "style Heading1",
    "text Second",
    "style Normal",
    "end"
  ],
  "expect": {
    "diagnosticCount": 0,
    "paragraphs": [
      "Alpha",
      "First",
      "Second"
    ]
  }
}
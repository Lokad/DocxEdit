{
  "id": "invalid-comment-author",
  "description": "Refuses a whitespace-only comment author with E4205.",
  "input": {
    "bodyXml": [
      "    <w:p><w:r><w:t>Commented</w:t></w:r></w:p>"
    ]
  },
  "patch": [
    "docxpatch 1",
    "",
    "op add-comment",
    "target M.P0001",
    "text Note",
    "author \" \"",
    "end"
  ],
  "expect": {
    "applySuccess": false,
    "diagnosticCount": 1,
    "diagnosticCodes": [
      "E4205"
    ],
    "diagnosticMessagesContain": [
      "must not be empty"
    ]
  }
}
    "commentsIdsXml": [
      "    <w16cid:commentsIds xmlns:w16cid=\"http://schemas.microsoft.com/office/word/2016/wordml/cid\">",
      "      <w16cid:commentId w16cid:paraId=\"00REPLY1\" w16cid:durableId=\"7F0A11BC\"/>",
      "    </w16cid:commentsIds>"
    ]
  },
  "patch": [
    "docxpatch 1",
    "",
    "op delete-comment-reply",
    "target comment:3.reply:1",

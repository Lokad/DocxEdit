{
  "id": "alias-multi-text-refusal",
  "description": "Refuses a result alias on multi-text insertion with E4205.",
  "input": {
    "bodyXml": [
      "    <w:p><w:r><w:t>Alpha</w:t></w:r></w:p>"
    ]
  },
  "patch": [
    "docxpatch 1",
    "",
    "op insert-after",
    "target M.P0001",
    "text First",
    "text Second",
    "as multi",
    "end"
  ],
  "expect": {
    "applySuccess": false,
    "diagnosticCount": 1,
    "diagnosticCodes": [
      "E4205"
    ],
    "diagnosticMessagesContain": [
      "single created object"
    ]
  }
}
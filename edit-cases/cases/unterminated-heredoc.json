{
  "id": "unterminated-heredoc",
  "description": "Rejects a heredoc value without a closing delimiter.",
  "input": {
    "bodyXml": [
      "    <w:p><w:r><w:t>Alpha Beta</w:t></w:r></w:p>"
    ]
  },
  "patch": [
    "docxpatch 1",
    "",
    "op replace-text",
    "target M.P0001",
    "find Alpha",
    "with <<<",
    "Beta",
    "end"
  ],
  "expect": {
    "applySuccess": false,
    "diagnosticCount": 1,
    "diagnosticCodes": [
      "E2008"
    ],
    "diagnosticMessagesContain": [
      "Unterminated heredoc"
    ]
  }
}
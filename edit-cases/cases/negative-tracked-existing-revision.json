      "    <w:p>",
      "      <w:ins w:id=\"1\" w:author=\"Existing\" w:date=\"2026-06-01T00:00:00Z\">",
      "        <w:r><w:t>Inserted </w:t></w:r>",
      "      </w:ins>",
      "      <w:r><w:t>plain text</w:t></w:r>",
      "    </w:p>"
    ]
  },
  "applyOptions": {
    "trackChanges": "require",
    "author": "Public Reviewer",
    "timestampUtc": "2026-06-11T12:00:00Z"
  },
  "patch": [
    "docxpatch 1",
    "",
    "op replace-text",
    "target M.P0001",
    "find Inserted",
    "with edited",
    "end"
  ],
  "expect": {
    "applySuccess": false,
    "diagnosticCount": 1,

{
  "id": "invalid-hyperlink-uri",
  "description": "Refuses a malformed hyperlink target URI with E4205.",
  "input": {
    "bodyXml": [
      "    <w:p>",
      "      <w:hyperlink xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\" r:id=\"rLink\">",
      "        <w:r><w:t>External</w:t></w:r>",
      "      </w:hyperlink>",
      "    </w:p>"
    ],
    "hyperlink": "https://example.test/report"
  },
  "patch": [
    "docxpatch 1",
    "",
    "op set-hyperlink-target",
    "target M.L0001",
    "uri http://[::1",
    "end"
  ],
  "expect": {
    "applySuccess": false,
    "diagnosticCount": 1,
    "diagnosticCodes": [
      "E4205"
    ],
    "diagnosticMessagesContain": [
      "malformed URI"
    ]
  }
}
      "    <w:p>",
      "      <w:sdt>",
      "        <w:sdtPr>",
      "          <w:date>",
      "            <w:dateFormat w:val=\"yyyy-MM-dd\"/>",
      "            <w:fullDate w:val=\"2026-06-12T00:00:00Z\"/>",
      "          </w:date>",
      "          <w:tag w:val=\"deadline\"/>",
      "        </w:sdtPr>",
      "        <w:sdtContent><w:r><w:t>2026-06-12</w:t></w:r></w:sdtContent>",
      "      </w:sdt>",
      "    </w:p>"
    ]
  },
  "patch": [
    "docxpatch 1",
    "",
    "op set-content-control-date",

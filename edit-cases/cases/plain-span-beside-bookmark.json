{
  "id": "plain-span-beside-bookmark",
  "description": "Edits plain text beside a bookmark and preserves the bookmark range.",
  "input": {
    "bodyXml": [
      "    <w:p>",
      "      <w:r><w:t>Before </w:t></w:r>",
      "      <w:bookmarkStart w:id=\"4\" w:name=\"ClientName\"/>",
      "      <w:r><w:t>Bookmarked</w:t></w:r>",
      "      <w:bookmarkEnd w:id=\"4\"/>",
      "      <w:r><w:t> After</w:t></w:r>",
      "    </w:p>"
    ]
  },
  "patch": [
    "docxpatch 1",
    "",
    "op replace-text",
    "target M.P0001",
    "find Before",
    "with Pre",
    "end"
  ],
  "expect": {
    "diagnosticCount": 0,
    "paragraphs": [
      "Pre Bookmarked After"
    ],
    "bookmarkNames": [
      "ClientName"
    ]
  }
}
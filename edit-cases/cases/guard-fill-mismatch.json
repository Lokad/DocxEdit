{
  "id": "guard-fill-mismatch",
  "description": "Fails cell shading on a mismatched expect-fill guard with E3201.",
  "input": {
    "bodyXml": [
      "    <w:tbl>",
      "      <w:tr>",
      "        <w:tc><w:p><w:r><w:t>North</w:t></w:r></w:p></w:tc>",
      "        <w:tc><w:p><w:r><w:t>Revenue</w:t></w:r></w:p></w:tc>",
      "      </w:tr>",
      "      <w:tr>",
      "        <w:tc><w:p><w:r><w:t>South</w:t></w:r></w:p></w:tc>",
      "        <w:tc><w:p><w:r><w:t>Profit</w:t></w:r></w:p></w:tc>",
      "      </w:tr>",
      "    </w:tbl>"
    ]
  },
  "patch": [
    "docxpatch 1",
    "",
    "op set-cell-shading",
    "target M.T0001.R01.C01",
    "expect-fill FF0000",
    "fill A1B2C3",
    "end"
  ],
  "expect": {
    "applySuccess": false,
    "diagnosticCount": 1,
    "diagnosticCodes": [
      "E3201"
    ],
    "diagnosticMessagesContain": [
      "Guard failed"
    ]
  }
}
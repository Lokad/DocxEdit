{
  "id": "shading-exclusive",
  "description": "Rejects contradictory fill and clear fields in one operation.",
  "input": {
    "bodyXml": [
      "    <w:tbl>",
      "      <w:tr><w:tc><w:p><w:r><w:t>Body</w:t></w:r></w:p></w:tc></w:tr>",
      "    </w:tbl>"
    ]
  },
  "patch": [
    "docxpatch 1",
    "",
    "op set-cell-shading",
    "target M.T0001.R01.C01",
    "fill FF0000",
    "clear true",
    "end"
  ],
  "expect": {
    "applySuccess": false,
    "diagnosticCount": 1,
    "diagnosticCodes": [
      "E4202"
    ],
    "diagnosticMessagesContain": [
      "cannot combine"
    ]
  }
}
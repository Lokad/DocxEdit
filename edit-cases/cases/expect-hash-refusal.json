{
  "id": "expect-hash-refusal",
  "description": "Rejects the prohibited expect-hash field without loading the document.",
  "input": {
    "bodyXml": [
      "    <w:p><w:r><w:t>Alpha Beta</w:t></w:r></w:p>"
    ]
  },
  "patch": [
    "docxpatch 1",
    "",
    "op replace-text",
    "target M.P0001",
    "find Alpha",
    "with Beta",
    "expect-hash deadbeef",
    "end"
  ],
  "expect": {
    "applySuccess": false,
    "diagnosticCount": 1,
    "diagnosticCodes": [
      "E2004"
    ],
    "diagnosticMessagesContain": [
      "not supported"
    ]
  }
}
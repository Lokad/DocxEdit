{
  "id": "rename-bookmark",
  "description": "Renames a bookmark under a guard; paragraph text is unchanged.",
  "input": {
    "bodyXml": [
      "    <w:p>",
      "      <w:r><w:t>Before </w:t></w:r>",
      "      <w:bookmarkStart w:id=\"4\" w:name=\"ClientName\"/>",
      "      <w:r><w:t>Old Client</w:t></w:r>",
      "      <w:bookmarkEnd w:id=\"4\"/>",
      "      <w:r><w:t> After</w:t></w:r>",
      "    </w:p>"
    ]
  },
  "patch": [
    "docxpatch 1",
    "",
    "op rename-bookmark",
    "target M.B0001",
    "expect-name ClientName",
    "name RenamedClient",
    "end"
  ],
  "expect": {
    "diagnosticCount": 0,
    "paragraphs": [
      "Before Old Client After"
    ],
    "bookmarkNames": [
      "RenamedClient"
    ]
  }
}
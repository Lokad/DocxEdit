{
  "id": "invalid-bookmark-name",
  "description": "Refuses a bookmark name containing whitespace with E4205.",
  "input": {
    "bodyXml": [
      "    <w:p><w:r><w:t>Alpha</w:t></w:r></w:p>"
    ]
  },
  "patch": [
    "docxpatch 1",
    "",
    "op add-bookmark",
    "target M.P0001",
    "name Bad Name",
    "end"
  ],
  "expect": {
    "applySuccess": false,
    "diagnosticCount": 1,
    "diagnosticCodes": [
      "E4205"
    ],
    "diagnosticMessagesContain": [
      "without whitespace"
    ]
  }
}
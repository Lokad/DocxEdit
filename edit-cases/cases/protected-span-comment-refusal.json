{
  "id": "protected-span-comment-refusal",
  "description": "Refuses a text span crossing a comment range with E4305 instead of hollowing it.",
  "input": {
    "bodyXml": [
      "    <w:p>",
      "      <w:r><w:t>Note </w:t></w:r>",
      "      <w:commentRangeStart w:id=\"3\"/>",
      "      <w:r><w:t>Commented</w:t></w:r>",
      "      <w:commentRangeEnd w:id=\"3\"/>",
      "      <w:r><w:commentReference w:id=\"3\"/></w:r>",
      "    </w:p>"
    ],
    "commentsXml": [
      "    <w:comments xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\">",
      "      <w:comment w:id=\"3\" w:author=\"Reviewer\" w:initials=\"RV\" w:date=\"2026-06-07T12:00:00Z\">",
      "        <w:p><w:r><w:t>Old comment</w:t></w:r></w:p>",
      "      </w:comment>",
      "    </w:comments>"
    ]
  },
  "patch": [
    "docxpatch 1",
    "",
    "op replace-text",
    "target M.P0001",
    "find Note Commented",
    "with Changed",
    "end"
  ],
  "expect": {
    "applySuccess": false,
    "diagnosticCount": 1,
    "diagnosticCodes": [
      "E4305"
    ],
    "diagnosticMessagesContain": [
      "comment"
    ]
  }
}
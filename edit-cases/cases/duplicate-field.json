{
  "id": "duplicate-field",
  "description": "Rejects a repeated nonrepeatable field instead of silently overwriting.",
  "input": {
    "bodyXml": [
      "    <w:p><w:r><w:t>Alpha Beta</w:t></w:r></w:p>"
    ]
  },
  "patch": [
    "docxpatch 1",
    "",
    "op replace-text",
    "target M.P0001",
    "target M.P0002",
    "find Alpha",
    "with Beta",
    "end"
  ],
  "expect": {
    "applySuccess": false,
    "diagnosticCount": 1,
    "diagnosticCodes": [
      "E2015"
    ],
    "diagnosticMessagesContain": [
      "more than once"
    ]
  }
}
{
  "id": "negative-tracked-cell-tabs",
  "description": "Rejects tracked cell replacement whose text contains a tab.",
  "input": {
    "bodyXml": [
      "    <w:tbl>",
      "      <w:tr><w:tc><w:p><w:r><w:t>Old</w:t></w:r></w:p></w:tc></w:tr>",
      "    </w:tbl>"
    ]
  },
  "applyOptions": {
    "trackChanges": "require",
    "author": "Public Reviewer",
    "timestampUtc": "2026-06-11T12:00:00Z"
  },
  "patch": [
    "docxpatch 1",
    "",
    "op set-cell",
    "target M.T0001.R01.C01",
    "text \"A\\tB\"",
    "end"
  ],
  "expect": {
    "applySuccess": false,
    "diagnosticCount": 1,
    "diagnosticCodes": [
      "E6002"
    ],
    "diagnosticMessagesContain": [
      "tracked paragraph text contains tabs or line breaks"
    ]
  }
}
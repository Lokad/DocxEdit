{
  "id": "delete-bookmark",
  "description": "Deletes a bookmark while preserving the bookmarked text.",
  "input": {
    "bodyXml": [
      "    <w:p>",
      "      <w:r><w:t>Before </w:t></w:r>",
      "      <w:bookmarkStart w:id=\"4\" w:name=\"ClientName\"/>",
      "      <w:r><w:t>Bookmarked</w:t></w:r>",
      "      <w:bookmarkEnd w:id=\"4\"/>",
      "      <w:r><w:t> After</w:t></w:r>",
      "    </w:p>"
    ]
  },
  "patch": [
    "docxpatch 1",
    "",
    "op delete-bookmark",
    "target M.B0001",
    "expect-name ClientName",
    "end"
  ],
  "expect": {
    "diagnosticCount": 0,
    "paragraphs": [
      "Before Bookmarked After"
    ],
    "bookmarkNames": []
  }
}
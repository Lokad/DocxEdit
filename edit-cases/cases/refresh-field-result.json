{
  "id": "refresh-field-result",
  "description": "Refreshes a REF field cached result from its bookmark under a guard.",
  "input": {
    "bodyXml": [
      "    <w:p>",
      "      <w:bookmarkStart w:id=\"1\" w:name=\"ClientName\"/>",
      "      <w:r><w:t>Acme Corp</w:t></w:r>",
      "      <w:bookmarkEnd w:id=\"1\"/>",
      "    </w:p>",
      "    <w:p>",
      "      <w:fldSimple w:instr=\" REF ClientName \\h \" w:dirty=\"true\">",
      "        <w:r><w:t>Old cached result</w:t></w:r>",
      "      </w:fldSimple>",
      "    </w:p>"
    ]
  },
  "patch": [
    "docxpatch 1",
    "",
    "op refresh-field-result",
    "target M.F0001",
    "expect-result Old cached result",
    "end"
  ],
  "expect": {
    "diagnosticCount": 0,
    "paragraphs": [
      "Acme Corp",
      "Acme Corp"
    ]
  }
}
{
  "id": "remove-hyperlink",
  "description": "Removes guarded hyperlink markup while preserving display runs.",
  "input": {
    "bodyXml": [
      "    <w:p>",
      "      <w:hyperlink xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\" r:id=\"rLink\">",
      "        <w:r><w:t>External</w:t></w:r>",
      "      </w:hyperlink>",
      "    </w:p>"
    ],
    "hyperlink": "https://example.test/report"
  },
  "patch": [
    "docxpatch 1",
    "",
    "op remove-hyperlink",
    "target M.L0001",
    "expect-text External",
    "end"
  ],
  "expect": {
    "diagnosticCount": 0,
    "paragraphs": [
      "External"
    ],
    "hyperlinkUris": []
  }
}
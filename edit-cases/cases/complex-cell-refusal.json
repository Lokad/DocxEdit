    "bodyXml": [
      "    <w:tbl>",
      "      <w:tr><w:tc><w:p><w:r><w:t>First</w:t></w:r></w:p><w:p><w:r><w:t>Second</w:t></w:r></w:p></w:tc></w:tr>",
      "    </w:tbl>"
    ]
  },
  "patch": [
    "docxpatch 1",
    "",
    "op set-cell",
    "target M.T0001.R01.C01",
    "text New",

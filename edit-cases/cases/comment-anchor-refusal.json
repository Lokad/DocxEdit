{
  "id": "comment-anchor-refusal",
  "description": "Refuses a comment anchor span crossing a tab with E4317.",
  "input": {
    "bodyXml": [
      "    <w:p><w:r><w:t>A</w:t><w:tab/><w:t>B</w:t></w:r></w:p>"
    ]
  },
  "patch": [
    "docxpatch 1",
    "",
    "op add-comment",
    "target M.P0001",
    "anchor-text \"A\\tB\"",
    "text Note",
    "end"
  ],
  "expect": {
    "applySuccess": false,
    "diagnosticCount": 1,
    "diagnosticCodes": [
      "E4317"
    ],
    "diagnosticMessagesContain": [
      "tabs, line breaks, or non-text run content"
    ]
  }
}
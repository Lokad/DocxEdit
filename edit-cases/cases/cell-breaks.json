{
  "id": "cell-breaks",
  "description": "Replaces cell text with multiline content preserving line breaks.",
  "input": {
    "bodyXml": [
      "    <w:tbl>",
      "      <w:tr><w:tc><w:p><w:r><w:t>Old</w:t></w:r></w:p></w:tc></w:tr>",
      "    </w:tbl>"
    ]
  },
  "patch": [
    "docxpatch 1",
    "",
    "op set-cell",
    "target M.T0001.R01.C01",
    "text <<<",
    "Line one",
    "Line two",
    ">>>",
    "end"
  ],
  "expect": {
    "diagnosticCount": 0,
    "tableCells": [
      "Line one\nLine two"
    ]
  }
}
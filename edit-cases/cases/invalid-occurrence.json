{
  "id": "invalid-occurrence",
  "description": "Refuses a non-positive occurrence selector with E4205.",
  "input": {
    "bodyXml": [
      "    <w:p><w:r><w:t>Alpha Alpha</w:t></w:r></w:p>"
    ]
  },
  "patch": [
    "docxpatch 1",
    "",
    "op replace-text",
    "target M.P0001",
    "find Alpha",
    "with Omega",
    "occurrence 0",
    "end"
  ],
  "expect": {
    "applySuccess": false,
    "diagnosticCount": 1,
    "diagnosticCodes": [
      "E4205"
    ],
    "diagnosticMessagesContain": [
      "greater than 0"
    ]
  }
}